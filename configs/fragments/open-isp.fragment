# Open ISP stack (experimental): open-tx-isp kernel driver.
# Userspace ABI defaults to the proprietary Ingenic libimp.so because
# the T31 OpenIMP build is video-focused and lacks the IMP audio/IVS
# entry points prudynt links against.
BR2_PACKAGE_THINGINO_ISP_OPEN=y
BR2_PACKAGE_THINGINO_ISP_OPEN_ABI_LIBIMP=y
